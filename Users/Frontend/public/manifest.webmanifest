{
  "id": "/",
  "name": "E-Balik · UMak Lost & Found",
  "short_name": "E-Balik",
  "description": "Report lost and found items at the University of Makati, get matched automatically, and claim what's yours.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0e1830",
  "theme_color": "#162448",
  "lang": "en",
  "categories": [
    "education",
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Report an item",
      "short_name": "Report",
      "description": "Report something you found or lost",
      "url": "/?open=report-item",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My reports",
      "short_name": "My reports",
      "description": "Check the reports you posted",
      "url": "/?open=my-reports",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Smart Tags",
      "short_name": "Smart Tags",
      "description": "Manage your Smart Tag stickers",
      "url": "/?open=my-tags",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Auction Hall",
      "short_name": "Auctions",
      "description": "Bid on unclaimed items",
      "url": "/?open=auction-hall",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
