# Frontend (Vercel) environment variables. Paste into Vercel > Project > Settings > Environment Variables.
# These are baked into the build, so redeploy after changing them. Never put secrets here: everything
# prefixed VITE_ is visible to anyone who opens the site.

# Your Render service URL, no trailing slash
VITE_API_URL=https://ebalik-api.onrender.com
# Render's free tier sleeps after 15 minutes idle; the first request can take up to a minute to wake it.
VITE_API_TIMEOUT=60000
VITE_ENV=production
VITE_ENABLE_OTP_VERIFICATION=true
VITE_ENABLE_PASSWORD_RESET=true

# Google sign-in (optional; same client ID as the backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Leave VITE_ADMIN_URL unset: the admin console is served from the same site at /admin/.
