# Backend (Render) environment variables. This file is a checklist: paste each value into
# Render > ebalik-api > Environment. Never commit real values. See DEPLOYMENT_GUIDE.md.

FLASK_ENV=production
PYTHON_VERSION=3.13.4

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Random secrets. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 32 bytes as base64. Generate with:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# If you already enrolled admins in MFA, reuse the SAME value you use locally, or their authenticators stop working.
APP_ENCRYPTION_KEY=

# Your Vercel site, no trailing slash. Several origins can be comma-separated.
CORS_ORIGINS=https://YOUR-SITE.vercel.app
# The same address. Smart Tag QR codes point to <this>/tag/<code>, so set it before printing stickers.
PUBLIC_SITE_URL=https://YOUR-SITE.vercel.app
# Smart Tag types admins may generate (comma separated: qr, rfid, nfc). Leave as qr until you have RFID or NFC hardware.
SMART_TAG_TYPES_ENABLED=qr

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional). With AUCTION_EMAIL_MODE=auto, real emails are sent once SENDGRID_API_KEY is set; otherwise they are only logged.
AUCTION_EMAIL_MODE=auto
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

OTP_EXPIRATION_MINUTES=10

# Optional tuning. The daily administrator summary email is sent from this hour (Makati time) onwards, once per day.
# ADMIN_DIGEST_HOUR=8
# The most rows an admin list reads (Supabase returns 1000 per request; lists are paged up to this).
# ADMIN_LIST_MAX=10000
# Emergency only: lets a production server start with missing or default secrets. Leave unset.
# ALLOW_INSECURE_START=
