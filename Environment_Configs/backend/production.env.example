# Backend (Render) environment variables. This file is a checklist: paste each value into
# Render > ebalik-api > Environment. Never commit real values. See DEPLOYMENT_GUIDE.md.

FLASK_ENV=production
PYTHON_VERSION=3.13.4

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Random secrets. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 32 bytes as base64. Generate with:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# If you already enrolled admins in MFA, reuse the SAME value you use locally, or their authenticators stop working.
APP_ENCRYPTION_KEY=

# Your Vercel site, no trailing slash. Several origins can be comma-separated.
CORS_ORIGINS=https://YOUR-SITE.vercel.app

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional). While AUCTION_EMAIL_MODE=mock, auction winner emails are only logged.
AUCTION_EMAIL_MODE=mock
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

OTP_EXPIRATION_MINUTES=10
